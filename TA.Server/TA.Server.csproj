<Project Sdk="Microsoft.NET.Sdk">
  <!-- Servizio Windows TCP/Kerberos senza HTTP o IIS. -->
  <PropertyGroup><OutputType>Exe</OutputType><Version>2.28.0</Version><TargetFramework>net10.0-windows</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.DirectoryServices.AccountManagement" Version="10.0.13" />
    <EmbeddedResource Include="IpripiRules.json" LogicalName="TA.Server.IpripiRules.json" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <ProjectReference Include="../TA.Core/TA.Core.csproj" />
    <ProjectReference Include="../TA.Transport/TA.Transport.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Grafica dello studio per l'esportazione del curriculum: usata quando in Configura non è indicata un'altra cartella. -->
    <Content Include="Assets/CurriculumGrafica/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
