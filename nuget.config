<?xml version="1.0" encoding="utf-8"?>
<!-- GeCo.Dati (libreria del database comune con GeCo2027) è pubblicata su GitHub Packages di studiotassinari.
     Per compilare serve un token con permesso read:packages nella variabile d'ambiente GECO_PACKAGES_TOKEN
     (su GitHub Actions lo imposta il flusso di lavoro). Vedi deployment/DATABASE-COMUNE.md. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="studiotassinari" value="https://nuget.pkg.github.com/studiotassinari/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
    <packageSource key="studiotassinari"><package pattern="GeCo.*" /></packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <studiotassinari>
      <add key="Username" value="%GITHUB_ACTOR%" />
      <add key="ClearTextPassword" value="%GECO_PACKAGES_TOKEN%" />
    </studiotassinari>
  </packageSourceCredentials>
</configuration>
