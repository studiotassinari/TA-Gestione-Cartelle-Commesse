<UserControl x:Class="TA_Gestione_Cartelle_Commesse.Views.ConnectionStatusView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12" TextElement.FontWeight="Normal">
  <DockPanel Margin="0,0,0,8">
   <Button DockPanel.Dock="Right" Content="Connetti" Command="{Binding ConnectCommand}"/>
   <TextBox DockPanel.Dock="Right" Width="90" Text="{Binding ServerPort,UpdateSourceTrigger=PropertyChanged}" ToolTip="Porta TCP dedicata" Margin="8,0,0,0"/>
   <TextBlock Text="Server" VerticalAlignment="Center" Margin="0,0,10,0"/>
   <TextBox Text="{Binding ServerHost,UpdateSourceTrigger=PropertyChanged}" ToolTip="Nome DNS della VM"/>
  </DockPanel>
  <DockPanel Margin="0,0,0,8">
   <Button DockPanel.Dock="Right" Content="Verifica connessione" Command="{Binding CheckCommunicationCommand}"/>
   <CheckBox Content="Usa il mio account Windows" IsChecked="{Binding UseCurrentAccount}" VerticalAlignment="Center"/>
  </DockPanel>
  <TextBlock Text="{Binding CommunicationStatus}" TextWrapping="Wrap"/>
 </StackPanel></ScrollViewer>
</UserControl>
