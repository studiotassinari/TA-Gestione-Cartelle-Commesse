<UserControl x:Class="TA_Gestione_Cartelle_Commesse.Views.ConnectionStatusView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="8">
   <TextBlock Text="Server" Margin="0,0,0,4"/>
   <TextBox Text="{Binding ServerHost,UpdateSourceTrigger=PropertyChanged}" ToolTip="Nome DNS della VM" Margin="0,0,0,8"/>
   <DockPanel Margin="0,0,0,8">
    <Button DockPanel.Dock="Right" Content="Connetti" Command="{Binding ConnectCommand}"/>
    <TextBlock Text="Porta TCP" VerticalAlignment="Center" Margin="0,0,8,0"/>
    <TextBox Width="90" HorizontalAlignment="Left" Text="{Binding ServerPort,UpdateSourceTrigger=PropertyChanged}"/>
   </DockPanel>
   <CheckBox Content="Usa il mio account Windows" IsChecked="{Binding UseCurrentAccount}" Margin="0,0,0,8"/>
   <Button Content="Verifica connessione" Command="{Binding CheckCommunicationCommand}" HorizontalAlignment="Left" Margin="0,0,0,6"/>
   <TextBlock Text="{Binding CommunicationStatus}" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding ReportStatus}" TextWrapping="Wrap" Margin="0,6"/>
   <TextBlock Text="{Binding ProgressDetail}" TextWrapping="Wrap" Foreground="#135F6E" Margin="0,6"/>
   <TextBlock Text="{Binding ArchiveLocation}" TextWrapping="Wrap" Foreground="#536775"/>
   <TabControl Margin="0,8,0,0" MinHeight="150"><TabControl.Resources><Style TargetType="TabItem"><Setter Property="Padding" Value="12,8"/></Style></TabControl.Resources>
    <TabItem Header="Commesse"><StackPanel DataContext="{Binding Commesse}"><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/><TextBlock Text="{Binding ArchiveStatus}" TextWrapping="Wrap"/><ListBox ItemsSource="{Binding Warnings}" MaxHeight="80"/></StackPanel></TabItem>
    <TabItem Header="Gare"><StackPanel DataContext="{Binding Gare}"><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/><TextBlock Text="{Binding ArchiveStatus}" TextWrapping="Wrap"/><ListBox ItemsSource="{Binding Warnings}" MaxHeight="80"/></StackPanel></TabItem>
    <TabItem Header="Archivio"><StackPanel DataContext="{Binding Archivio}"><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/><TextBlock Text="{Binding ArchiveStatus}" TextWrapping="Wrap"/><ListBox ItemsSource="{Binding Warnings}" MaxHeight="80"/></StackPanel></TabItem>
   </TabControl>
  </StackPanel>
 </ScrollViewer>
</UserControl>
