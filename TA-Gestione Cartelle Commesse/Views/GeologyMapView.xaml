<UserControl x:Class="TA_Gestione_Cartelle_Commesse.Views.GeologyMapView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
 <Border BorderBrush="#D6E0E2" BorderThickness="1" Background="White">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Margin="12" Text="Mappa delle relazioni · OpenStreetMap" FontSize="16" FontWeight="Bold"/>
   <wv:WebView2 x:Name="Browser" Grid.Row="1"/>
   <Border Grid.Row="1" x:Name="Placeholder" Background="#EAF0F1" Padding="32"><TextBlock x:Name="PlaceholderText" Text="Caricamento della mappa OpenStreetMap… Nessuna chiave o servizio a pagamento richiesto." TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320" FontSize="16" Foreground="#135F6E"/></Border>
   <TextBlock x:Name="MapStatus" Grid.Row="2" Text="I documenti senza coordinate restano disponibili nell’elenco." TextWrapping="Wrap" Margin="12" FontSize="12" Foreground="#135F6E"/>
  </Grid>
 </Border>
</UserControl>
