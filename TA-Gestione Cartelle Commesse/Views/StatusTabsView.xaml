<UserControl x:Class="TA_Gestione_Cartelle_Commesse.Views.StatusTabsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <TabControl SelectedIndex="{Binding StatusTabIndex,Mode=TwoWay}" x:Name="StatusTabs">
  <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Padding" Value="18,7"/><Setter Property="Foreground" Value="#135F6E"/></Style></TabControl.Resources>
  <TabItem Header="Scansione">
   <DockPanel Margin="10" TextElement.FontWeight="Normal">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
     <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressSchedule}" Foreground="#536775" FontSize="12" Margin="16,0,0,0"/>
     <TextBlock Text="{Binding ProgressCaption}" FontWeight="Bold"/>
    </DockPanel>
    <DataGrid ItemsSource="{Binding ScanLog}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" RowHeight="23" ColumnHeaderHeight="27" GridLinesVisibility="None" SelectionMode="Single" FontSize="12" ToolTip="Ultime cartelle osservate dal client, più recenti in alto. Percorso interno ZIP/7z separato da &gt;. Nessun contenuto dei documenti.">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Ora" Binding="{Binding Time}" Width="80"/>
      <DataGridTextColumn Header="Categoria" Binding="{Binding Category}" Width="90"/>
      <DataGridTextColumn Header="Fase" Binding="{Binding Phase}" Width="175"/>
      <DataGridTextColumn Header="Cartella / archivio in elaborazione" Binding="{Binding Path}" Width="*" MinWidth="280"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding Path}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
     </DataGrid.Columns>
    </DataGrid>
   </DockPanel>
  </TabItem>
  <TabItem Header="Connessione"><local:ConnectionStatusView xmlns:local="clr-namespace:TA_Gestione_Cartelle_Commesse.Views"/></TabItem>
  <TabItem Header="Archivio JSON">
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12" TextElement.FontWeight="Normal">
    <TextBlock Text="{Binding ArchiveLocation}" Foreground="#536775" Margin="0,0,0,8"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel DataContext="{Binding Commesse}" Margin="0,0,12,0"><TextBlock Text="Commesse" FontWeight="Bold"/><TextBlock Text="{Binding ArchiveStatus}" TextWrapping="Wrap" Margin="0,6"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/></StackPanel>
     <StackPanel Grid.Column="1" DataContext="{Binding Gare}" Margin="0,0,12,0"><TextBlock Text="Gare" FontWeight="Bold"/><TextBlock Text="{Binding ArchiveStatus}" TextWrapping="Wrap" Margin="0,6"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/></StackPanel>
     <StackPanel Grid.Column="2" DataContext="{Binding Archivio}"><TextBlock Text="Archivio" FontWeight="Bold"/><TextBlock Text="{Binding ArchiveStatus}" TextWrapping="Wrap" Margin="0,6"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/></StackPanel>
    </Grid>
   </StackPanel></ScrollViewer>
  </TabItem>
  <TabItem Header="Messaggi">
   <DockPanel Margin="10" TextElement.FontWeight="Normal">
    <TextBlock DockPanel.Dock="Top" Text="{Binding ReportStatus}" TextWrapping="Wrap" Margin="0,0,0,6"/>
    <TabControl><TabControl.Resources><Style TargetType="TabItem"><Setter Property="Padding" Value="10,4"/></Style></TabControl.Resources>
     <TabItem Header="Commesse"><ListBox ItemsSource="{Binding Commesse.Warnings}"/></TabItem>
     <TabItem Header="Gare"><ListBox ItemsSource="{Binding Gare.Warnings}"/></TabItem>
     <TabItem Header="Archivio"><ListBox ItemsSource="{Binding Archivio.Warnings}"/></TabItem>
    </TabControl>
   </DockPanel>
  </TabItem>
 </TabControl>
</UserControl>
