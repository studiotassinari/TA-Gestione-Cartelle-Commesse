<Window x:Class="TA_Gestione_Cartelle_Commesse.Views.GeologyWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:TA_Gestione_Cartelle_Commesse.Views"
 Title="Relazioni geologiche e geotecniche — Studio Tassinari" Width="1440" Height="900" MinWidth="1000" MinHeight="650"
 Background="#F3F6F6" Foreground="#192845" FontFamily="../Assets/Brand/#Acherus Grotesque" FontSize="13" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="#B8CDD1"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="8,0,0,0"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,7"/><Setter Property="Margin" Value="8,0,0,0"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#192845"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="9"/></Style>
 </Window.Resources>
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16">
   <StackPanel><TextBlock Text="Relazioni geologiche e geotecniche" FontSize="24" FontWeight="Bold"/><TextBlock Text="Catalogo territoriale · documenti originali in sola lettura" Foreground="#135F6E" Margin="0,5,0,0"/></StackPanel>
   <Button DockPanel.Dock="Right" Content="Aggiorna catalogo" Command="{Binding RefreshCommand}" HorizontalAlignment="Right"/>
  </DockPanel>
  <DockPanel Grid.Row="1" Margin="0,0,0,12">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock Text="Posizione" VerticalAlignment="Center" Margin="12,0,0,0"/><ComboBox Width="140" ItemsSource="{Binding Locations}" SelectedItem="{Binding Location}" AutomationProperties.Name="Posizione geografica"/></StackPanel>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock Text="Tipo" VerticalAlignment="Center" Margin="12,0,0,0"/><ComboBox Width="125" ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" AutomationProperties.Name="Tipo di relazione"/></StackPanel>
   <TextBlock DockPanel.Dock="Left" Text="Cerca" VerticalAlignment="Center" Margin="0,0,10,0"/>
   <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}" ToolTip="Cerca titolo, località, indirizzo, commessa, committente o autore" AutomationProperties.Name="Cerca relazioni"/>
  </DockPanel>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="6*" MinWidth="430"/><ColumnDefinition Width="8"/><ColumnDefinition Width="5*" MinWidth="360"/></Grid.ColumnDefinitions>
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="8"/><RowDefinition Height="230" MinHeight="150"/></Grid.RowDefinitions>
    <DataGrid x:Name="ReportsGrid" MouseDoubleClick="Reports_DoubleClick" ToolTip="Doppio clic: apri una copia del documento in sola lettura" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" EnableRowVirtualization="True" RowHeight="36" Background="White" BorderBrush="#D6E0E2">
     <DataGrid.RowStyle><Style TargetType="DataGridRow">
      <Setter Property="ToolTip" Value="{Binding ServerLocation}"/>
      <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
      <EventSetter Event="PreviewMouseRightButtonDown" Handler="Report_RightClick"/>
      <Setter Property="ContextMenu"><Setter.Value><ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
       <MenuItem Header="Apri documento (copia in sola lettura)" Command="{Binding OpenDocumentCommand}"/>
       <MenuItem Header="Apri percorso in Esplora file" Command="{Binding OpenFolderCommand}"/>
      </ContextMenu></Setter.Value></Setter>
     </Style></DataGrid.RowStyle>
     <DataGrid.Columns>
      <DataGridTextColumn Header="Relazione" Binding="{Binding Title}" Width="240" MinWidth="220"/>
      <DataGridTextColumn Header="Località" Binding="{Binding Municipality}" Width="*" MinWidth="95"/>
      <DataGridTextColumn Header="Indirizzo" Binding="{Binding Address}" Width="180" MinWidth="150"/>
      <DataGridTextColumn Header="Percorso sul server" Binding="{Binding ServerLocation}" Width="300" MinWidth="250"/>
      <DataGridTextColumn Header="Commessa" Binding="{Binding ProjectLabel}" Width="135" MinWidth="120"/>
      <DataGridTextColumn Header="Fascicolo" Binding="{Binding DossierTitle}" Width="150" MinWidth="130"/>
      <DataGridTextColumn Header="Analisi" Binding="{Binding AnalysisStatus}" Width="150" MinWidth="130"/>
      <DataGridTextColumn Header="Tipo" Binding="{Binding Kind}" Width="95" MinWidth="90"/>
     </DataGrid.Columns>
    </DataGrid>
    <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" Background="Transparent"/>
    <Border Grid.Row="2" Background="White" BorderBrush="#D6E0E2" BorderThickness="1" Padding="14">
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel DataContext="{Binding Selected}">
       <TextBlock Text="{Binding Title, TargetNullValue=Seleziona una relazione nell’elenco o sulla mappa}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding PositionLabel}" Foreground="#135F6E" Margin="0,8,0,0" TextWrapping="Wrap"/>
       <Button Content="Apri documento" Command="{Binding DataContext.OpenDocumentCommand, RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Left"/>
       <TextBlock Text="{Binding DossierTitle, StringFormat=Fascicolo: {0}}" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding AnalysisStatus}" TextWrapping="Wrap"/>
       <Button Content="Imposta posizione…" Click="Position_Click" HorizontalAlignment="Left" IsEnabled="{Binding DataContext.CanLocate, RelativeSource={RelativeSource AncestorType=Window}}"/>
       <Button Content="Localizza indirizzo con Nominatim…" Click="Geocode_Click" HorizontalAlignment="Left" IsEnabled="{Binding DataContext.CanGeocode, RelativeSource={RelativeSource AncestorType=Window}}" Margin="8,8,0,0"/>
       <TextBlock Text="{Binding ServerLocation, StringFormat=Percorso sul server: {0}}" TextWrapping="Wrap" Margin="0,6,0,0"/>
       <TextBlock Text="{Binding ProjectLabel}" Margin="0,6,0,0"/><TextBlock Text="{Binding Client}"/>
       <TextBlock Text="{Binding Author}"/><TextBlock Text="{Binding FileName}" TextWrapping="Wrap" Margin="0,6,0,0"/>
       <TextBlock Text="{Binding PositionSource, StringFormat=Fonte posizione: {0}}" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding DetectionStatus}" FontWeight="Bold"/><TextBlock Text="{Binding DetectionEvidence}" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" Margin="0,6,0,0"/>
      </StackPanel>
     </ScrollViewer>
    </Border>
   </Grid>
   <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"/>
   <views:GeologyMapView x:Name="Map" Grid.Column="2"/>
  </Grid>
  <StackPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock Text="{Binding CountText}" FontWeight="Bold"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#135F6E" Margin="0,4,0,0"/></StackPanel>
 </Grid>
</Window>
