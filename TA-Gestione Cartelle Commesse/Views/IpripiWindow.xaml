<Window x:Class="TA_Gestione_Cartelle_Commesse.Views.IpripiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IPRiPI · Analisi MUR A.1/D.1" Width="1280" Height="820" MinWidth="900" MinHeight="600"
        Background="#F4F6F9" WindowStartupLocation="CenterScreen">
    <Grid Margin="24" Background="#F4F6F9">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Interventi privi di rilevanza sismica" FontSize="25" FontWeight="SemiBold" Foreground="#17344D"/>
            <TextBlock Text="MUR A.1/D.1 · DGR Emilia-Romagna 2272/2016, Allegato 1" FontSize="14" Margin="0,6,0,0"/>
            <TextBlock Text="Proposte di ChatGPT con fonti verificabili. Originali in sola lettura; verifica tecnica a cura del progettista." TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#526070"/>
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,12" VerticalAlignment="Center">
            <StackPanel Margin="0,0,12,6"><TextBlock Text="Codice commessa"/><TextBox Width="145" Padding="6" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Codice commessa"/></StackPanel>
            <StackPanel Margin="0,0,12,6"><TextBlock Text="Nome, codice IPRiPI o stato"/><TextBox Width="250" Padding="6" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Ricerca documenti"/></StackPanel>
            <CheckBox Content="Tutti i PDF (anche rinominati)" IsChecked="{Binding AllPdfs}" VerticalAlignment="Center" Margin="0,12,16,0"/>
            <Button Content="Cerca / aggiorna" Command="{Binding RefreshCommand}" Padding="16,8" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
        </WrapPanel>
        <DockPanel Grid.Row="2" Margin="0,0,0,12" LastChildFill="False">
            <TextBlock Text="{Binding CountText}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
            <Button Content="Esporta vista JSON" Click="Export_Click" DockPanel.Dock="Right" Padding="10,6" Margin="8,0,0,0"/>
            <Button Content="Copia richiesta per ChatGPT" Click="Copy_Click" DockPanel.Dock="Right" Padding="10,6" Margin="8,0,0,0"/>
            <Button Content="Apri copia PDF" Command="{Binding OpenCommand}" DockPanel.Dock="Right" Padding="10,6"/>
        </DockPanel>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*" MinWidth="370"/><ColumnDefinition Width="10"/><ColumnDefinition Width="2*" MinWidth="280"/></Grid.ColumnDefinitions>
            <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="White" AutomationProperties.Name="PDF MUR e analisi IPRiPI">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Commessa" Binding="{Binding ProjectCode}" Width="90"/>
                    <DataGridTextColumn Header="PDF" Binding="{Binding FileName}" Width="*" MinWidth="140"/>
                    <DataGridTextColumn Header="Codici" Binding="{Binding Codes}" Width="120"/>
                    <DataGridTextColumn Header="Stato" Binding="{Binding Status}" Width="200"/>
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="#CAD3DC"/>
            <TextBox Grid.Column="2" Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="16" Background="White" BorderBrush="#D4DCE4" AutomationProperties.Name="Interventi, motivazioni e citazioni"/>
        </Grid>
        <TextBlock Grid.Row="4" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#526070"/>
    </Grid>
</Window>
