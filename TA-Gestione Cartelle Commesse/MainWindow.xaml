<Window x:Class="TA_Gestione_Cartelle_Commesse.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:TA_Gestione_Cartelle_Commesse.ViewModels"
 Title="TA-Gestione Cartelle Commesse" Width="1300" Height="900" MinWidth="900" MinHeight="700" Background="#F3F6F6" Foreground="#192845" FontSize="13" FontFamily="./Assets/Brand/#Acherus Grotesque" Icon="Assets/Brand/App.ico" UseLayoutRounding="True">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <SolidColorBrush x:Key="BrandTeal" Color="#135F6E"/>
        <SolidColorBrush x:Key="BrandNight" Color="#192845"/>
        <Style TargetType="MenuItem">
            <Setter Property="Padding" Value="14,8"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#135F6E"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D6E0E2"/>
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5ECEE"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#192845"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#135F6E"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#D6E0E2"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Background" Value="#135F6E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#135F6E"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#192845"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#192845"/>
                                <Setter TargetName="ButtonSurface" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#B8CDD1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type vm:FolderNode}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Name}" ToolTip="{Binding Path}"/>
        </HierarchicalDataTemplate>
        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
        </Style>
        <DataTemplate x:Key="CategoryTemplate">
            <Grid Margin="16" TextElement.FontWeight="Normal">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="110"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="Annulla lettura" Command="{Binding CancelCommand}"/>
                    <Button DockPanel.Dock="Right" Content="Aggiorna elenco" Command="{Binding RefreshCommand}"/>
                    <TextBox Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIdle}" ToolTip="Cartella radice"/>
                </DockPanel>
                <DockPanel Grid.Row="1" Margin="0,0,0,12">
                    <TextBlock Text="Cerca codice, cliente o argomento" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DataGrid ItemsSource="{Binding Records}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" AlternatingRowBackground="#F0F6F6">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="FolderRow_RightButtonDown"/>
                                <EventSetter Event="MouseDoubleClick" Handler="FolderRow_DoubleClick"/>
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="Apri cartella in Esplora file" Command="{Binding OpenFolderCommand}"/>
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Codice" Binding="{Binding Code}" Width="90"/>
                            <DataGridTextColumn Header="Anno (XX)" Binding="{Binding Year}" Width="90"/>
                            <DataGridTextColumn Header="N." Binding="{Binding Number}" Width="55"/>
                            <DataGridTextColumn Header="Cliente" Binding="{Binding Client}" Width="2*"/>
                            <DataGridTextColumn Header="Argomento" Binding="{Binding Subject}" Width="3*"/>
                            <DataGridTextColumn Header="Esito" Binding="{Binding Status}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>
                    <GroupBox Grid.Column="2" Header="Gerarchia cartelle">
                        <TreeView ItemsSource="{Binding Hierarchy}"/>
                    </GroupBox>
                </Grid>
                <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="#135F6E" Margin="0,12,0,8" TextWrapping="Wrap"/>
                <GroupBox Grid.Row="4" Header="Segnalazioni di lettura e nomi non conformi">
                    <ListBox ItemsSource="{Binding Warnings}" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                </GroupBox>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <DockPanel Margin="18">
        <Menu DockPanel.Dock="Top" Margin="0,0,0,14" Padding="4" Background="White">
            <MenuItem Header="_Apri">
                <MenuItem Header="Apri cartella in Esplora file" Command="{Binding ActiveCategory.OpenFolderCommand}"/>
            </MenuItem>
            <MenuItem Header="_Export">
                <MenuItem Header="Crea report cartelle e non conformità" Command="{Binding ReportCommand}"/>
            </MenuItem>
        </Menu>
        <Border DockPanel.Dock="Top" Background="White" Margin="0,0,0,16" BorderBrush="#135F6E" BorderThickness="0,0,0,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Source="Assets/Brand/Logo.png" Width="240" Stretch="Uniform" Margin="40" AutomationProperties.Name="Tassinari Associati"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,20,24,20">
                    <TextBlock Text="Gestione Cartelle Commesse" FontSize="25" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock Text="Commesse e gare · Archivio e verifica delle denominazioni" Foreground="#135F6E" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>
        <TextBlock DockPanel.Dock="Top" Text="{Binding ReportStatus}" Foreground="#536775" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"/>
        <TabControl SelectedIndex="{Binding ActiveTabIndex, Mode=TwoWay}">
            <TabItem Header="   Commesse   ">
                <ContentControl Content="{Binding Commesse}" ContentTemplate="{StaticResource CategoryTemplate}"/>
            </TabItem>
            <TabItem Header="   Gare   ">
                <ContentControl Content="{Binding Gare}" ContentTemplate="{StaticResource CategoryTemplate}"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>