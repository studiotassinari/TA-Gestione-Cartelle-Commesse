<Window x:Class="TA_Gestione_Cartelle_Commesse.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:TA_Gestione_Cartelle_Commesse.ViewModels"
 Title="TA-Gestione Cartelle Commesse" Width="1300" Height="800" MinWidth="900" MinHeight="600" Background="#F3F6FA">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type vm:FolderNode}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Name}" ToolTip="{Binding Path}"/>
        </HierarchicalDataTemplate>
        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
        </Style>
        <DataTemplate x:Key="CategoryTemplate">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="130"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="Annulla lettura" Command="{Binding CancelCommand}"/>
                    <Button DockPanel.Dock="Right" Content="Aggiorna elenco" Command="{Binding RefreshCommand}"/>
                    <TextBox Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIdle}" ToolTip="Cartella radice"/>
                </DockPanel>
                <DockPanel Grid.Row="1" Margin="0,0,0,12">
                    <TextBlock Text="Cerca codice, cliente o argomento" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DataGrid ItemsSource="{Binding Records}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" AlternatingRowBackground="#F0F4F8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Codice" Binding="{Binding Code}" Width="90"/>
                            <DataGridTextColumn Header="Anno (XX)" Binding="{Binding Year}" Width="75"/>
                            <DataGridTextColumn Header="N." Binding="{Binding Number}" Width="55"/>
                            <DataGridTextColumn Header="Cliente" Binding="{Binding Client}" Width="2*"/>
                            <DataGridTextColumn Header="Argomento" Binding="{Binding Subject}" Width="3*"/>
                            <DataGridTextColumn Header="Esito" Binding="{Binding Status}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>
                    <GroupBox Grid.Column="2" Header="Gerarchia cartelle">
                        <TreeView ItemsSource="{Binding Hierarchy}"/>
                    </GroupBox>
                </Grid>
                <TextBlock Grid.Row="3" Text="{Binding Status}" Margin="0,12,0,8" TextWrapping="Wrap"/>
                <GroupBox Grid.Row="4" Header="Segnalazioni di lettura e nomi non conformi">
                    <ListBox ItemsSource="{Binding Warnings}" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                </GroupBox>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="TA · Gestione Cartelle Commesse" FontSize="26" FontWeight="SemiBold" Foreground="#18334D"/>
            <TextBlock Text="Consultazione in sola lettura · Commesse e gare" Foreground="#526779" Margin="0,6,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12"><Button Content="Crea report cartelle e non conformità" Command="{Binding ReportCommand}" HorizontalAlignment="Left"/><TextBlock Text="{Binding ReportStatus}" Margin="6,8,0,0" TextWrapping="Wrap"/></StackPanel><TabControl>
            <TabItem Header="   Commesse   ">
                <ContentControl Content="{Binding Commesse}" ContentTemplate="{StaticResource CategoryTemplate}"/>
            </TabItem>
            <TabItem Header="   Gare   ">
                <ContentControl Content="{Binding Gare}" ContentTemplate="{StaticResource CategoryTemplate}"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>