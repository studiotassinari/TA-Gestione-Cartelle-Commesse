
<Window x:Class="TA_Gestione_Cartelle_Commesse.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:TA_Gestione_Cartelle_Commesse.Views" xmlns:vm="clr-namespace:TA_Gestione_Cartelle_Commesse.ViewModels" Title="TA-Gestione Cartelle Commesse" Width="1600" Height="1000" WindowState="Maximized" MinWidth="900" MinHeight="850" Background="#F3F6F6" Foreground="#192845" FontSize="13" FontFamily="./Assets/Brand/#Acherus Grotesque" Icon="Assets/Brand/App.ico" UseLayoutRounding="True" Loaded="Window_Loaded">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <SolidColorBrush x:Key="BrandTeal" Color="#135F6E"/>
        <SolidColorBrush x:Key="BrandNight" Color="#192845"/>
        <Style TargetType="MenuItem">
            <Setter Property="Padding" Value="14,8"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#135F6E"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D6E0E2"/>
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5ECEE"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#192845"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#135F6E"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#D6E0E2"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Background" Value="#135F6E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#135F6E"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#192845"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#192845"/>
                                <Setter TargetName="ButtonSurface" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#B8CDD1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type vm:FolderNode}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Name}" ToolTip="{Binding Path}"/>
        </HierarchicalDataTemplate>
        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
        </Style>
        <DataTemplate x:Key="CategoryTemplate">
            <Grid Margin="16" TextElement.FontWeight="Normal">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="Annulla verifica server" Command="{Binding CancelCommand}"/>
                    <Button DockPanel.Dock="Right" Content="Aggiorna elenco" Command="{Binding RefreshCommand}"/>
                    <TextBox Text="{Binding RootPath, Mode=OneWay}" IsReadOnly="True" ToolTip="Cartella radice"/>
                </DockPanel>
                <DockPanel Grid.Row="1" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Left" Content="{Binding CreateLabel}" Command="{Binding CreateCommand}" Margin="0,0,14,0" ToolTip="Crea la cartella dal modello, con anteprima prima della conferma">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers><DataTrigger Binding="{Binding CanCreate}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                        </Style></Button.Style>
                    </Button>
                    <TextBlock Text="Cerca codice, anno, numero, cliente o argomento" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DataGrid ItemsSource="{Binding Records}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" AlternatingRowBackground="#F0F6F6">
                        <DataGrid.Style><Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                            <Style.Triggers><DataTrigger Binding="{Binding IsProjectCategory}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                        </Style></DataGrid.Style>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="FolderRow_RightButtonDown"/>
                                <EventSetter Event="MouseDoubleClick" Handler="FolderRow_DoubleClick"/>
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="Apri cartella in Esplora file" Command="{Binding OpenFolderCommand}"/>
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Codice" Binding="{Binding Code}" Width="90"/>
                            <DataGridTextColumn Header="Anno" Binding="{Binding Year}" Width="65"/>
                            <DataGridTextColumn Header="Numero" Binding="{Binding Number, StringFormat={}{0:D3}}" Width="80"/>
                            <DataGridTextColumn Header="Committente" Binding="{Binding Client}" Width="180" MinWidth="150"/>
                            <DataGridTextColumn Header="Argomento" Binding="{Binding Subject}" Width="260" MinWidth="200"/>
                            <DataGridTextColumn Header="Dimensione" Binding="{Binding SizeText}" Width="160"/>
                            <DataGridTextColumn Header="Verifica dimensioni (UTC)" Binding="{Binding Inspection.CheckedUtc, StringFormat=dd/MM/yyyy HH:mm}" Width="165"/>
                            <DataGridTextColumn Header="Esito" Binding="{Binding Status}" Width="100"/>
                            <DataGridTextColumn Header="Ultima modifica file" Binding="{Binding Inspection.LastWriteText}" Width="160"/>
                            <DataGridTextColumn Header="Preventivo" Binding="{Binding Inspection.QuoteStatus}" Width="210"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  Visibility="{Binding IsProjectCategory, Converter={StaticResource BoolVisibility}}">
                        <views:WorkProjectListView MinWidth="1180"/>
                    </ScrollViewer>
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>
                    <GroupBox Grid.Column="2" Header="Gerarchia cartelle">
                        <TreeView ItemsSource="{Binding Hierarchy}" PreviewMouseDoubleClick="Hierarchy_DoubleClick"/>
                    </GroupBox>
                </Grid>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <DockPanel Margin="18" Background="#F3F6F6">
        <Menu DockPanel.Dock="Top" Margin="0,0,0,14" Padding="4" Background="White">
            <MenuItem Header="_Gestione">
                <MenuItem Header="Nuova commessa da modello…" Command="{Binding CreateJobCommand}"/>
                <MenuItem Header="Nuova gara…" Command="{Binding CreateBidCommand}"/>
                <MenuItem Header="Clienti e commesse associate…" Command="{Binding CustomersCommand}"/>
                <MenuItem Header="Pianificazione, attività e ore…" Command="{Binding BusinessCommand}"/>
                <MenuItem Header="Curriculum dello studio…" Command="{Binding CurriculumCommand}"/>
                <Separator/>
                <MenuItem Header="Archivia cartella in ZIP…" Command="{Binding ArchiveFolderCommand}"/>
          <MenuItem Header="Apri cartella selezionata" Command="{Binding ActiveCategory.OpenFolderCommand}"/>
            </MenuItem>
            <MenuItem Header="_Analisi e report">
                <MenuItem Header="Relazioni geologiche e geotecniche…" Command="{Binding GeologyCommand}"/>
                <MenuItem Header="Moduli MUR A.1/D.1…" Command="{Binding IpripiCommand}"/>
                <MenuItem Header="Non conformità…" Command="{Binding NonconformityReportCommand}"/>
                <Separator/>
                <MenuItem Header="Esporta">
                    <MenuItem Header="Ultimo report giornaliero" Command="{Binding DailyReportCommand}"/>
                    <MenuItem Header="Analisi nomi e differenze" Command="{Binding AnalysisReportCommand}"/>
                    <MenuItem Header="Cartelle e non conformità" Command="{Binding ReportCommand}"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Sistema">
                <MenuItem Header="Stato scansione" Command="{Binding ShowScanCommand}"/>
                <MenuItem Header="Connessione al server" Command="{Binding ShowConnectionCommand}"/>
                <MenuItem Header="Verifica comunicazione" Command="{Binding CheckCommunicationCommand}"/>
                <MenuItem Header="Modifiche ricevute" Command="{Binding ChangesCommand}"/>
                <Separator/>
                <MenuItem Header="Gestione servizio (responsabili autorizzati)" Command="{Binding ManageServerCommand}"/>
                <MenuItem Header="Verifica aggiornamenti" Command="{Binding UpdateCommand}"/>
            </MenuItem>
            <MenuItem Header="_Aiuto"><MenuItem Header="Informazioni" Command="{Binding AboutCommand}"/></MenuItem>
        </Menu>
        <Border DockPanel.Dock="Top" Background="White" Margin="0,0,0,16" BorderBrush="#135F6E" BorderThickness="0,0,0,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Source="Assets/Brand/Logo.png" Width="180" Stretch="Uniform" Margin="24" AutomationProperties.Name="Tassinari Associati"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,20,24,20">
                    <TextBlock Text="Gestione Cartelle Commesse" FontSize="25" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock Text="Commesse e gare · Archivio e verifica delle denominazioni" Foreground="#135F6E" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="2*" MinHeight="280"/><RowDefinition Height="8"/><RowDefinition Height="*" MinHeight="170"/></Grid.RowDefinitions>
            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#B8CDD1" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"/>
            <views:StatusTabsView Grid.Row="2"/>
        <TabControl SelectedIndex="{Binding ActiveTabIndex, Mode=TwoWay}">
            <TabItem Header="   Commesse   ">
                <ContentControl Content="{Binding Commesse}" ContentTemplate="{StaticResource CategoryTemplate}"/>
            </TabItem>
            <TabItem Header="   Gare   ">
                <ContentControl Content="{Binding Gare}" ContentTemplate="{StaticResource CategoryTemplate}"/>
            </TabItem>
        <TabItem Header="   Archivio   "><ContentControl Content="{Binding Archivio}" ContentTemplate="{StaticResource CategoryTemplate}"/></TabItem></TabControl>
        </Grid>
    </DockPanel>
</Window>
